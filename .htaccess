# Configuración del servidor en Hostinger (Apache/LiteSpeed)

# Una sola dirección: siempre https y sin www -> https://sinverso.com/
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://sinverso.com%{REQUEST_URI} [L,R=301]

# /index.html -> / (evita dos direcciones para la misma página)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# No mostrar el contenido de las carpetas ni archivos internos del repositorio
Options -Indexes
RedirectMatch 404 /(\.git|diseno)(/|$)
<FilesMatch "^(\.gitignore|\.nojekyll|README\.md)$">
  Require all denied
</FilesMatch>

# Compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

# Caché del navegador: CSS y JS un año (llevan ?v= en index.html, se renuevan solos al cambiar);
# imágenes, video y fuentes una semana (no llevan versión: si se reemplaza una con el mismo nombre, se ve en días); el HTML siempre se revisa
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType video/mp4 "access plus 1 week"
  ExpiresByType font/ttf "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
